# kevin-Mini data server. Generated by setup-data-server.ps1 from
# data-server/Caddyfile.template; edit the template and re-run the script.
{
	auto_https off
	persist_config off
	# A service runs in System32; keep Caddy's state in a folder it can write.
	storage file_system __STATE_DIR__
	# The service manager discards stderr, so startup errors would otherwise be lost.
	log {
		output file __CADDY_LOG__ {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

http://:__PORT__ {
	__BIND__
	root * __DATA_ROOT__

	log {
		output file __LOG_FILE__ {
			roll_size 10MiB
			roll_keep 5
		}
	}

	# Explicit types: on Windows, Go reads them from the registry, where Excel
	# maps .csv to application/vnd.ms-excel.
	@csv path *.csv
	header @csv Content-Type "text/csv; charset=utf-8"
	@json path *.json
	header @json Content-Type "application/json"
	@ndjson path *.ndjson *.jsonl
	header @ndjson Content-Type "application/x-ndjson"
	@parquet path *.parquet
	header @parquet Content-Type "application/vnd.apache.parquet"

	# CORS for browser tools on the LAN; DuckDB/pyarrow need the range headers exposed.
	header {
		Access-Control-Allow-Origin "*"
		Access-Control-Expose-Headers "Content-Length, Content-Range, Accept-Ranges, ETag, Last-Modified"
		X-Content-Type-Options "nosniff"
	}

	@preflight method OPTIONS
	handle @preflight {
		header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		header Access-Control-Allow-Headers "Range, If-None-Match, If-Modified-Since, Authorization"
		header Access-Control-Max-Age "86400"
		respond 204
	}

	__AUTH__

	# Default match types cover text and JSON, not Parquet (already compressed).
	encode zstd gzip

	file_server browse {
		hide .* desktop.ini Thumbs.db
	}
}
